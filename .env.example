# Helix — copy to .env and adjust for deployment
HUB_SECRET_KEY=replace-with-a-long-random-string

# Admin — full access including Settings
HUB_ADMIN_USERNAME=admin
HUB_ADMIN_PASSWORD=admin

# Operator — run jobs, history, metrics (no Settings)
# Anyone signed in can watch Active jobs; only the starter can stop their own job.
HUB_OPERATOR_USERNAME=operator
HUB_OPERATOR_PASSWORD=operator

# Legacy aliases (optional): still map to the admin account if set
# HUB_USERNAME=admin
# HUB_PASSWORD=admin

# Optional: default PNR portal password for CLI runs outside the Hub
# PNR_PASSWORD=

# Booking API credentials live in config/scripts.json (Booking API workflow
# inputs marked Hidden). Edit them in Settings → Workflows — not here.
