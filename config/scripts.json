          "width": "half",
          "help": "Only needed for round trip.",
          "show_when": {
            "mode": [
              "availability"
            ]
          },
          "cli": {
            "flag": "--return-date",
            "position": null
          }
        },
        {
          "id": "nationality",
          "label": "Passenger nationality",
          "type": "text",
          "required": false,
          "default": "NP",
          "placeholder": "NP",
          "group": "Passenger details",
          "width": "half",
          "help": "Two-letter country code. NP = Nepal.",
          "collapsed": true,
          "show_when": {
            "mode": [
              "availability"
            ]
          },
          "cli": {
            "flag": "--nationality",
            "position": null
          }
        },
        {
          "id": "adults",
          "label": "Adults",
          "type": "text",
          "input_type": "number",
          "required": false,
          "default": "1",
          "placeholder": "1",
          "group": "Passenger details",
          "width": "half",
          "help": "How many adult travellers.",
          "collapsed": true,
          "show_when": {
            "mode": [
              "availability"
            ]
          },
          "cli": {
            "flag": "--adults",
            "position": null
          }
        },
        {
          "id": "children",
          "label": "Children",
          "type": "text",
          "input_type": "number",
          "required": false,
          "default": "0",
          "placeholder": "0",
          "group": "Passenger details",
          "width": "half",
          "help": "How many child travellers.",
          "collapsed": true,
          "show_when": {
            "mode": [
              "availability"
            ]
          },
          "cli": {
            "flag": "--children",
            "position": null
          }
        },
        {
          "id": "from_date",
          "label": "From date",
          "type": "text",
          "input_type": "date",
          "required": false,
          "default": "2024-01-01",
          "group": "Sales dates",
          "width": "half",
          "help": "Start of the sales period.",
          "show_when": {
            "mode": [
              "sales"
            ]
          },
          "cli": {
            "flag": "--from-date",
            "position": null
          }
        },
        {
          "id": "to_date",
          "label": "To date",
          "type": "text",
          "input_type": "date",
          "required": false,
          "default": "2024-12-31",
          "group": "Sales dates",
          "width": "half",
          "help": "End of the sales period.",
          "show_when": {
            "mode": [
              "sales"
            ]
          },
          "cli": {
            "flag": "--to-date",
            "position": null
          }
        },
        {
          "id": "airline_id",
          "label": "Airline",
          "type": "select",
          "required": false,
          "default": "ALL",
          "group": "Balance check",
          "width": "full",
          "help": "Which airline wallet to check, or all of them.",
          "show_when": {
            "mode": [
              "balance"
            ]
          },
          "options": [
            {
              "value": "ALL",
              "label": "All airlines"
            },
            {
              "value": "U4",
              "label": "Buddha Air"
            },
            {
              "value": "YT",
              "label": "Yeti Airlines"
            },
            {
              "value": "S1",
              "label": "Saurya Airlines"
            },
            {
              "value": "SHA",
              "label": "Shree Airlines"
            },
            {
              "value": "RMK",
              "label": "Simrik Airlines"
            },
            {
              "value": "GA",
              "label": "Goma Airlines"
            },
            {
              "value": "ST",
              "label": "Sita Air"
            }
          ],
          "cli": {
            "flag": "--airline-id",
            "position": null
          }
        }
      ],
      "progress_hints": [
        {
          "match": "Authenticating",
          "label": "Authenticating…"
        },
        {
          "match": "Calling",
          "label": "Fetching from API…"
        },
        {
