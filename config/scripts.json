{
  "schema_version": "1.0.0",
  "python": ".venv/bin/python3",
  "output_dir": "outputs",
  "runtime": {
    "max_concurrent_jobs": 1,
    "default_timeout_seconds": 1800,
    "max_image_bytes": 26214400
  },
  "notifications": {
    "webhook_url": null,
    "on_success": true,
    "on_failure": true
  },
  "scripts": [
    {
      "id": "ocr",
      "name": "Image Processor",
      "description": "Turn flight-log photos into a clean spreadsheet.",
      "icon": "bi-image",
      "badge": "Active",
      "script": "scripts/ocr/main.py",
      "cwd": ".",
      "enabled": true,
      "timeout_seconds": 1800,
      "form_note": "Use Browse to pick an image folder (or upload a single image). CSV downloads from the result panel.",
      "summary_keys": [
        "airlines",
        "input_mode"
      ],
      "stages": [
        {
          "id": "read",
          "label": "Read images",
          "match": "Processing:"
        },
        {
          "id": "write",
          "label": "Write CSV",
          "match": "\u2192 csv="
        },
        {
          "id": "qc",
          "label": "Quality check",
          "match": "QC:"
        },
        {
          "id": "done",
          "label": "Finalize",
          "match": "CSV:"
        }
      ],
      "inputs": [
        {
          "id": "airlines",
          "label": "Airline",
          "type": "select",
          "required": true,
          "hidden": false,
          "default": "Buddha",
          "group": "Source",
          "width": "half",
          "help": "Parser plugin / OCR template.",
          "cli": {
            "flag": "--airlines"
          },
          "options": [
            {
              "value": "Buddha",
              "label": "Buddha Air"
            },
            {
              "value": "Yeti",
              "label": "Yeti Airlines"
            }
          ]
        },
        {
          "id": "input_mode",
          "label": "Input mode",
          "type": "select",
          "required": true,
          "hidden": false,
          "default": "folder",
          "group": "Source",
          "width": "half",
          "help": "Batch folder or a single uploaded image.",
          "cli": {
            "flag": "--input-mode"
          },
          "options": [
            {
              "value": "file",
              "label": "Single image"
            },
            {
              "value": "folder",
              "label": "Batch folder"
            }
          ]
        },
        {
          "id": "image_folder",
          "label": "Image Folder",
          "type": "folder",
          "required": false,
          "hidden": false,
          "group": "Source",
          "width": "full",
          "help": "Used when input mode is Batch folder.",
          "cli": {
            "flag": "--images"
          }
        },
        {
          "id": "image_file",
          "label": "Image File",
          "type": "file",
          "required": false,
          "hidden": false,
          "group": "Source",
          "width": "full",
          "help": "Used when input mode is Single image.",
          "cli": {
            "flag": "--image"
          },
          "accept": ".png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp"
        }
      ],
      "progress_hints": [
        {
          "match": "Processing:",
          "label": "Reading images\u2026"
        },
        {
          "match": "\u2192 csv=",
          "label": "Writing CSV\u2026"
        },
        {
          "match": "QC:",
          "label": "Quality check\u2026"
        },
        {
          "match": "CSV:",
          "label": "Finalizing\u2026"
        },
        {
          "match": "Done:",
          "label": "Complete"
        }
      ],
      "report": {
        "stdout_line_prefix": "CSV:",
        "glob": "*.csv",
        "pick": "newest_after_start",
        "result_ui": {
          "mode": "per_source",
          "title": "Outputs",
          "lead": "Select an image to preview its CSV.",
          "stats": "ocr"
        }
      },
      "summary_patterns": {
        "images_processed": "Processing:\\s*(\\S+)",
        "report_path": "CSV:\\s*(.+)",
        "qc_summary": "QC:\\s*(.+)",
        "rows_total": "rows_total=(\\d+)"
      }
    },
    {
      "id": "pnr",
      "name": "PNR \u2014 Yeti B2B booking",
      "description": "Book group seats on Yeti Airlines and collect the booking codes.",
      "icon": "bi-airplane",
      "badge": "Active",
      "script": "scripts/pnr/main.py",
      "cwd": ".",
      "enabled": true,
      "timeout_seconds": 7200,
      "form_note": "Results CSV is downloadable from the result panel after the run finishes.",
      "summary_keys": [
        "origin",
        "destination",
        "flight_number",
        "start_date",
        "end_date"
      ],
      "stages": [
        {
          "id": "login",
          "label": "Login",
          "match": "Logging in"
        },
        {
          "id": "search",
          "label": "Search",
          "match": "Searching"
        },
        {
          "id": "select",
          "label": "Select fare",
          "match": "Match:"
        },
        {
          "id": "book",
          "label": "Book",
          "match": "[advance"
        },
        {
          "id": "confirm",
          "label": "Confirm",
          "match": "Booking confirmed"
        },
        {
          "id": "export",
          "label": "Export",
          "match": "Writing CSV"
        }
      ],
      "inputs": [
        {
          "id": "origin",
          "label": "Origin",
          "type": "select",
          "required": true,
          "default": "KTM",
          "group": "Route & flight",
          "width": "half",
          "help": "From airport code.",
          "options": [
            {
              "value": "KTM",
              "label": "KTM \u2014 Kathmandu"
            },
            {
              "value": "BIR",
              "label": "BIR \u2014 Biratnagar"
            },
            {
              "value": "BDP",
              "label": "BDP \u2014 Bhadrapur"
            },
            {
              "value": "BWA",
              "label": "BWA \u2014 Bhairahawa"
            },
            {
              "value": "JKR",
              "label": "JKR \u2014 Janakpur"
            },
            {
              "value": "KEP",
              "label": "KEP \u2014 Nepalgunj"
            },
            {
              "value": "PKR",
              "label": "PKR \u2014 Pokhara"
            }
          ],
          "cli": {
            "flag": "--origin",
            "position": null
          }
        },
        {
          "id": "destination",
          "label": "Destination",
          "type": "select",
          "required": true,
          "default": "BIR",
          "group": "Route & flight",
          "width": "half",
          "help": "To airport code.",
          "options": [
            {
              "value": "BIR",
              "label": "BIR \u2014 Biratnagar"
            },
            {
              "value": "KTM",
              "label": "KTM \u2014 Kathmandu"
            },
            {
              "value": "BDP",
              "label": "BDP \u2014 Bhadrapur"
            },
            {
              "value": "BWA",
              "label": "BWA \u2014 Bhairahawa"
            },
            {
              "value": "JKR",
              "label": "JKR \u2014 Janakpur"
            },
            {
              "value": "KEP",
              "label": "KEP \u2014 Nepalgunj"
            },
            {
              "value": "PKR",
              "label": "PKR \u2014 Pokhara"
            },
            {
              "value": "TPU",
              "label": "TPU \u2014 Tikapur"
            }
          ],
          "cli": {
            "flag": "--destination",
            "position": null
          }
        },
        {
          "id": "flight_number",
          "label": "Flight number",
          "type": "text",
          "required": true,
          "default": "781",
          "group": "Route & flight",
          "width": "half",
          "help": "Number only (no YT prefix), e.g. 781.",
          "cli": {
            "flag": "--flight-number",
            "position": null
          }
        },
        {
          "id": "fare_code",
          "label": "Fare code",
          "type": "text",
          "required": true,
          "default": "E1",
          "group": "Route & flight",
          "width": "half",
          "help": "Fare class as shown in the portal table.",
          "cli": {
            "flag": "--fare-code",
            "position": null
          }
        },
        {
          "id": "start_date",
          "label": "Start date",
          "type": "text",
          "input_type": "date",
          "required": true,
          "default": "2026-08-02",
          "group": "Dates & group",
          "width": "half",
          "help": "Inclusive start of the booking range.",
          "cli": {
            "flag": "--start-date",
            "position": null
          }
        },
        {
          "id": "end_date",
          "label": "End date",
          "type": "text",
          "input_type": "date",
          "required": true,
          "default": "2026-08-31",
          "group": "Dates & group",
          "width": "half",
          "help": "Inclusive end of the booking range.",
          "cli": {
            "flag": "--end-date",
            "position": null
          }
        },
        {
          "id": "adults",
          "label": "Adults",
          "type": "text",
          "input_type": "number",
          "required": true,
          "default": "10",
          "group": "Dates & group",
          "width": "half",
          "help": "Group size (adult passengers).",
          "cli": {
            "flag": "--adults",
            "position": null
          }
        },
        {
          "id": "group_name",
          "label": "Group name",
          "type": "text",
          "required": false,
          "default": "CDV",
          "group": "Dates & group",
          "width": "half",
          "help": "Filled when the portal shows a group-name field.",
          "cli": {
            "flag": "--group-name",
            "position": null
          }
        },
        {
          "id": "agency_name",
          "label": "Agency name",
          "type": "text",
          "required": true,
          "default": "mmt",
          "group": "Portal login",
          "width": "half",
          "help": "B2B company / agency login field.",
          "cli": {
            "flag": "--agency-name",
            "position": null
          }
        },
        {
          "id": "user_login",
          "label": "User login",
          "type": "text",
          "required": true,
          "default": "",
          "group": "Portal login",
          "width": "half",
          "help": "Portal username.",
          "cli": {
            "flag": "--user-login",
            "position": null
          }
        },
        {
          "id": "password",
          "label": "Password",
          "type": "text",
          "input_type": "password",
          "required": true,
          "default": "",
          "group": "Portal login",
          "width": "full",
          "help": "Portal password for this run.",
          "cli": {
            "flag": "--password",
            "position": null
          }
        },
        {
          "id": "fare_price",
          "label": "Expected fare (NPR)",
          "type": "text",
          "input_type": "number",
          "required": false,
          "default": "7200",
          "group": "Advanced",
          "advanced": true,
          "width": "half",
          "help": "Sanity check only; mismatch logs a warning and continues.",
          "cli": {
            "flag": "--fare-price",
            "position": null
          }
        },
        {
          "id": "currency",
          "label": "Currency",
          "type": "select",
          "required": true,
          "default": "NPR",
          "group": "Advanced",
          "advanced": true,
          "width": "half",
          "options": [
            {
              "value": "NPR",
              "label": "NPR"
            },
            {
              "value": "USD",
              "label": "USD"
            }
          ],
          "cli": {
            "flag": "--currency",
            "position": null
          }
        },
        {
          "id": "headless",
          "label": "Hide browser window",
          "type": "boolean",
          "required": false,
          "default": true,
          "group": "Advanced",
          "advanced": true,
          "width": "full",
          "help": "ON = run without a visible Chromium window (recommended).",
          "cli": {
            "flag": "--headless",
            "position": null,
            "is_switch": true
          }
        }
      ],
      "progress_hints": [
        {
          "match": "Logging in",
          "label": "Logging in\u2026"
        },
        {
          "match": "Searching",
          "label": "Searching flights\u2026"
        },
        {
          "match": "Match:",
          "label": "Selecting fare\u2026"
        },
        {
          "match": "[advance",
          "label": "Advancing booking\u2026"
        },
        {
          "match": "Booking confirmed",
          "label": "PNR confirmed\u2026"
        },
        {
          "match": "Writing CSV",
          "label": "Writing CSV\u2026"
        },
        {
          "match": "SUMMARY",
          "label": "Summarizing\u2026"
        }
      ],
      "report": {
        "stdout_line_prefix": "CSV:",
        "glob": "*.csv",
        "pick": "newest_after_start",
        "result_ui": {
          "mode": "run_summary",
          "title": "Booking results",
          "lead": "One results CSV for this booking run.",
          "stats": "booking"
        }
      },
      "summary_patterns": {
        "booked": "SUMMARY:\\s*booked=(\\d+)",
        "failed": "SUMMARY:\\s*booked=\\d+\\s+failed=(\\d+)",
        "report_path": "CSV:\\s*(.+)",
        "rows_total": "rows_total=(\\d+)"
      }
    },
    {
      "id": "series_fare",
      "name": "Series Fare \u2014 TBO API upload",
      "description": "Upload a PNR CSV to TBO via CheckMFA + addSeriesFare API.",
      "icon": "bi-cloud-upload",
      "badge": "Active",
      "script": "scripts/series_fare/main.py",
      "cwd": ".",
      "enabled": true,
      "timeout_seconds": 1800,
      "form_note": "After OTP: paste TokenId and TraceId. HTTP headers (Origin, Referer, Cookie, User-Agent) are built by the script.",
      "summary_keys": [
        "limit",
        "dry_run"
      ],
      "stages": [
        {
          "id": "load",
          "label": "Read CSV",
          "match": "Loading sheet:"
        },
        {
          "id": "map",
          "label": "Map PNR \u2192 payload",
          "match": "Detected PNR CSV"
        },
        {
          "id": "auth",
          "label": "Authenticate",
          "match": "Auth:"
        },
        {
          "id": "post",
          "label": "POST addSeriesFare",
          "match": "Row "
        },
        {
          "id": "export",
          "label": "Write CSV",
          "match": "Writing CSV"
        },
        {
          "id": "done",
          "label": "Summarize",
          "match": "SUMMARY"
        }
      ],
      "inputs": [
        {
          "id": "sheet",
          "label": "PNR results CSV (or Series Fare sheet)",
          "type": "file",
          "required": true,
          "group": "1 \u00b7 CSV",
          "width": "full",
          "help": "PNR workflow CSV: status=booked + pnr. Grouped by route/flight/class into addSeriesFare calls.",
          "accept": ".csv,.xlsx,.xls",
          "cli": {
            "flag": "--sheet",
            "position": null
          }
        },
        {
          "id": "dry_run",
          "label": "Practice run (build payload, do not POST)",
          "type": "boolean",
          "required": false,
          "default": true,
          "group": "1 \u00b7 CSV",
          "width": "full",
          "help": "ON = writes series_fare_payload_N.json under outputs/. Nothing hits TBO.",
          "cli": {
            "flag": "--dry-run",
            "position": null,
            "is_switch": true
          }
        },
        {
          "id": "limit",
          "label": "Row limit (0 = all CSV rows)",
          "type": "text",
          "required": false,
          "default": "0",
          "group": "1 \u00b7 CSV",
          "width": "half",
          "input_type": "number",
          "cli": {
            "flag": "--limit",
            "position": null
          },
          "help": "Each CSV row becomes one addSeriesFare API call. 0 posts every row."
        },
        {
          "id": "disable_before_hrs",
          "label": "Disable before departure (hrs)",
          "type": "text",
          "required": false,
          "default": "24",
          "group": "1 \u00b7 CSV",
          "width": "half",
          "input_type": "number",
          "help": "Not in the CSV \u2014 applied to every DayAllocation row as DisableBeforeDept.",
          "cli": {
            "flag": "--disable-before-hrs",
            "position": null
          }
        },
        {
          "id": "token_id",
          "label": "TokenId (after OTP)",
          "type": "text",
          "required": false,
          "default": "",
          "group": "2 \u00b7 Auth from TBO UI",
          "width": "full",
          "placeholder": "eyJraWQiOiJ\u2026",
          "help": "Paste after OTP. Used in practice run payload and live POST.",
          "cli": {
            "flag": "--token-id",
            "position": null
          }
        },
        {
          "id": "trace_id",
          "label": "TraceId (after OTP)",
          "type": "text",
          "required": false,
          "default": "",
          "group": "2 \u00b7 Auth from TBO UI",
          "width": "full",
          "placeholder": "2e5fc0a3-1b2b-4889-afa5-da3666fbdbc9",
          "help": "Paste after OTP. Included in practice run payload and live POST.",
          "cli": {
            "flag": "--trace-id",
            "position": null
          }
        }
      ],
      "progress_hints": [
        {
          "match": "Loading sheet:",
          "label": "Reading CSV\u2026"
        },
        {
          "match": "Detected PNR CSV",
          "label": "Mapping PNR \u2192 API payload\u2026"
        },
        {
          "match": "Auth:",
          "label": "Authenticating\u2026"
        },
        {
          "match": "Row ",
          "label": "Posting inventory\u2026"
        },
        {
          "match": "Dry run",
          "label": "Writing practice payload\u2026"
        },
        {
          "match": "Writing CSV",
          "label": "Writing results\u2026"
        },
        {
          "match": "SUMMARY",
          "label": "Summarizing\u2026"
        }
      ],
      "report": {
        "stdout_line_prefix": "CSV:",
        "search_dir": "outputs",
        "glob": "*.csv",
        "pick": "newest_after_start",
        "result_ui": {
          "mode": "per_source",
          "title": "Upload results",
          "lead": "API upload results CSV.",
          "stats": "collect"
        }
      },
      "summary_patterns": {
        "added": "SUMMARY:\\s*added=(\\d+)",
        "failed": "SUMMARY:\\s*added=\\d+\\s+failed=(\\S+)",
        "report_path": "CSV:\\s*(.+)",
        "rows_total": "rows_total=(\\d+)"
      }
    }
  ],
  "pipelines": [
    {
      "id": "pnr_to_tbo",
      "name": "PNR \u2192 TBO Series Fare (API)",
      "description": "Book Yeti PNRs, then POST the CSV to TBO addSeriesFare.",
      "icon": "bi-diagram-3",
      "badge": "Pipeline",
      "enabled": true,
      "timeout_seconds": 10800,
      "form_note": "Practice run stays ON by default on the TBO step. Turn it off only after a payload looks right.",
      "steps": [
        {
          "id": "pnr",
          "label": "Book PNRs",
          "script_id": "pnr"
        },
        {
          "id": "series_fare",
          "label": "Upload to TBO",
          "script_id": "series_fare",
          "bind": {
            "sheet": "steps.pnr.report_path"
          },
          "hide_inputs": [
            "sheet"
          ]
        }
      ]
    }
  ]
}
